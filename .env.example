# ETHSecurity Intelligence: environment variables. Copy to .env.local and fill in.
# Never commit real values.

# MongoDB connection string (Atlas or local). When unset, the app serves the
# published dataset from data/published and stores corrections in .data/ (dev only).
MONGODB_URI=
MONGODB_DB=ethsecurity_intelligence

# Optional GitHub token for the research pipeline (raises the API rate limit).
GITHUB_TOKEN=

# Moderation: a long random secret. Moderators send it as "Authorization: Bearer <token>".
# Moderation endpoints are disabled while unset.
MODERATOR_TOKEN=

# Secret used to HMAC correction submitter IPs for rate limiting (never stored raw).
RATE_LIMIT_SALT=

# Key used to encrypt optional private contact details on corrections (32 bytes, base64).
# If unset, private contact fields are rejected rather than stored in plaintext.
CONTACT_ENCRYPTION_KEY=

# Public base URL (used in generated skills and MCP instructions).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official source (override only for testing against a mirror).
OFFICIAL_API_BASE=https://initiatives.thedao.fund

# Live pool and schedule: the server re-reads the vote manifest at most every 12 minutes
# (shared by all visitors) and shows it only when it validates. Set to "off" to serve the
# published snapshot only (the end-to-end tests and screenshots do this).
ESI_LIVE_MANIFEST=
